{
    "name": "NetLab Services",
    "category": "guest",
    "description": "All-in-One central network services VM (DNS, DHCP, RADIUS, TACACS+, LDAP, NTP, Syslog, TFTP, and FTP) based on Alpine Linux with a web management UI.",
    "vendor_name": "NetLab",
    "vendor_url": "https://github.com/netlab-services",
    "documentation_url": "https://github.com/netlab-services/wiki",
    "product_name": "NetLab Services Appliance",
    "registry_version": 6,
    "status": "stable",
    "maintainer": "NetLab Community",
    "maintainer_email": "community@netlab.local",
    "usage": "Connect the appliance to a switch. Wait for it to boot (approx. 5 seconds), then open a web browser and go to http://<appliance-ip> to access the Control Panel Web UI. Root login: root/netlab. Default TACACS+ secret is 'tacsecret', RADIUS secret is 'radsecret', LDAP base DN is 'dc=netlab,dc=local'. File manager files can be transferred via TFTP (UDP 69), FTP (TCP 21, anonymous or root), and SFTP (TCP 22).",
    "port_name_format": "eth{0}",
    "qemu": {
        "adapter_type": "virtio-net-pci",
        "adapters": 2,
        "ram": 512,
        "hda_disk_interface": "virtio",
        "arch": "x86_64",
        "console_type": "telnet",
        "boot_priority": "c",
        "kvm": "allow",
        "options": "-nographic"
    },
    "images": [
        {
            "filename": "netlab-services.qcow2",
            "version": "1.0",
            "md5sum": "7cb2310d0a9e928da5f2a62bdb033cfe",
            "filesize": 645529600
        }
    ],
    "versions": [
        {
            "name": "1.0",
            "images": {
                "hda_disk_image": "netlab-services.qcow2"
            }
        }
    ]
}
