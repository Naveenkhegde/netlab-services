{
    "name": "NetLab Services",
    "category": "guest",
    "description": "All-in-One central network services VM (IPAM, Multi-Scope DHCP, DNS, RADIUS, TACACS+, LDAP, NTP, TFTP, and FTP) based on Alpine Linux with a modern web control panel UI.",
    "vendor_name": "NetLab",
    "vendor_url": "https://github.com/netlab-services",
    "documentation_url": "https://github.com/netlab-services/wiki",
    "product_name": "NetLab Services Appliance",
    "registry_version": 6,
    "status": "stable",
    "maintainer": "NetLab Community",
    "maintainer_email": "community@netlab.local",
    "usage": "Connect the appliance to a switch. Wait for it to boot (approx. 5 seconds), then open a web browser and navigate to http://<appliance-ip> to access the Control Panel Web UI. Built-in IPAM engine, TACACS+ Command Authorization Builder & Simulator, RADIUS CoA / Disconnect Packet Generator, and Network Interface Manager. Root SSH login: root/netlab. Default TACACS+ secret: 'tacsecret', RADIUS secret: 'radsecret', LDAP base DN: 'dc=netlab,dc=local'.",
    "port_name_format": "eth{0}",
    "qemu": {
        "adapter_type": "virtio-net-pci",
        "adapters": 2,
        "ram": 512,
        "hda_disk_interface": "virtio",
        "arch": "x86_64",
        "console_type": "telnet",
        "boot_priority": "c",
        "kvm": "allow",
        "options": "-nographic"
    },
    "images": [
        {
            "filename": "netlab-services.qcow2",
            "version": "1.0",
            "md5sum": "c9dc94253865ba3208936de172e9e34f",
            "filesize": 649854976
        }
    ],
    "versions": [
        {
            "name": "1.0",
            "images": {
                "hda_disk_image": "netlab-services.qcow2"
            }
        }
    ]
}
