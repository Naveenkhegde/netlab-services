{
    "name": "NetLab Services",
    "category": "end_device",
    "description": "All-in-One central network services VM (DNS, DHCP, RADIUS, TACACS+, LDAP, and Syslog) based on Alpine Linux with a web management UI.",
    "vendor_name": "NetLab",
    "vendor_url": "https://github.com/netlab-services",
    "documentation_url": "https://github.com/netlab-services/wiki",
    "product_name": "NetLab Services Appliance",
    "registry_version": 6,
    "status": "stable",
    "maintainer": "NetLab Community",
    "maintainer_email": "community@netlab.local",
    "usage": "Connect the appliance to a switch. Wait for it to boot (approx. 5 seconds), then open a web browser and go to http://<appliance-ip> to access the Control Panel Web UI. Root login: root/netlab. Default TACACS+ secret is 'tacsecret', RADIUS secret is 'radsecret', LDAP base DN is 'dc=netlab,dc=local'.",
    "port_name_format": "eth{0}",
    "qemu": {
        "adapter_type": "virtio-net-pci",
        "adapters": 2,
        "ram": 512,
        "hda_disk_interface": "virtio",
        "arch": "x86_64",
        "console_type": "telnet",
        "boot_priority": "c",
        "kvm": "allowed",
        "options": "-nographic"
    },
    "images": [
        {
            "filename": "netlab-services.qcow2",
            "version": "1.0",
            "md5sum": "1aba485de485c892e9eaabcbe8086fc0",
            "filesize": 621477888
        }
    ],
    "versions": [
        {
            "name": "1.0",
            "images": {
                "hda_disk_image": "netlab-services.qcow2"
            }
        }
    ]
}
